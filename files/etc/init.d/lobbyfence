#!/bin/sh /etc/rc.common
# LobbyFence init script (procd)
# SPDX-License-Identifier: GPL-3.0-or-later

START=99
STOP=10
USE_PROCD=1

PROG=/usr/sbin/lobbyfence

start_service() {
	local enabled
	config_load lobbyfence
	config_get_bool enabled globals enabled 0
	if [ "$enabled" != 1 ]; then
		$PROG teardown >/dev/null 2>&1
		return 0
	fi

	# (when the rules can't be put in place, none are left - the router works
	# as without LobbyFence - and the learning loop below tries again on
	# every pass, so it is started either way)
	$PROG apply

	procd_open_instance
	procd_set_param command "$PROG" daemon
	# started again whenever it stops, however often (5 s apart): after the
	# default 5 tries procd would give up and leave the rules without it
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	$PROG teardown >/dev/null 2>&1
}

reload_service() {
	# no teardown: "apply" swaps the firewall table for the new one in a single
	# step, so filtering never stops during a settings change; the background
	# service reads the configuration again on its next pass
	start
}

service_triggers() {
	procd_add_reload_trigger "lobbyfence"
}

extra_command "status_report" "Show zones, learned servers and counters"
status_report() {
	$PROG status
}
